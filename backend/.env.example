# CareerPilot AI Backend Environment Configuration
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL

# -----------------------------------------------------------------------------
# CORE CONFIGURATION
# -----------------------------------------------------------------------------
APP_NAME="CareerPilot AI"
ENVIRONMENT="development" # Set to "production" in production
DEBUG=True # Set to False in production
FRONTEND_URL="http://localhost:5173" # Must match production frontend URL

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/careerpilot"

# -----------------------------------------------------------------------------
# SECURITY (CRITICAL - NO DEFAULT FALLBACKS IN PRODUCTION)
# -----------------------------------------------------------------------------
# Generate these using: openssl rand -hex 32
SECRET_KEY=""
SESSION_SECRET_KEY=""

# -----------------------------------------------------------------------------
# THIRD PARTY INTEGRATIONS
# -----------------------------------------------------------------------------
# Google OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# AI Models
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Sentry Monitoring (Optional but recommended)
SENTRY_DSN=""

# Emails (SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# EMAILS_FROM_EMAIL="your-email@gmail.com"

# -----------------------------------------------------------------------------
# STORAGE
# -----------------------------------------------------------------------------
# Options: "local" (default) or "supabase"
# STORAGE_PROVIDER="supabase"
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_SERVICE_KEY="your-service-role-key"
# SUPABASE_BUCKET="resumes"
