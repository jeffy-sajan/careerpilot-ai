# ═══════════════════════════════════════════════════
# .gitattributes — CareerPilot AI
#
# Forces consistent line endings across Windows/Mac/Linux.
# All text files are stored as LF (Unix) in the repo.
# Git converts to CRLF on Windows checkouts automatically.
# ═══════════════════════════════════════════════════

# Default behavior: normalize all text files to LF in the repo
* text=auto eol=lf

# Explicitly declare text files
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.txt       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.sh        text eol=lf
*.env*      text eol=lf
Dockerfile  text eol=lf
*.mako      text eol=lf

# Binary files — never modify line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
